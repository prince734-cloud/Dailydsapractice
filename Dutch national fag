#include <iostream>
#include<bits/stdc++.h>

using namespace std;
      // sort zero ,one and two ,dutch natinal flag
int main()
{
   int n;
   cin>>n;
   vector<int> arr(n);
   for(int i=0;i<n;i++){
       cin>>arr[i];
   }
   
   int low=0;
   int mid=0;
   int high =n-1;
   
   while(mid<=high){
       if(arr[mid]==0){
           swap(arr[mid],arr[low]);
           low++;
           mid++;
       }else if(arr[mid]==2){
           swap(arr[mid],arr[high]);
           high--;
       }
       else{
           mid++;
       }
   }
     for(int i=0;i<n;i++){
         cout<<arr[i]<<" ";
     }
    return 0;
}

class Solution {
public:
    string smallestSubsequence(string s) {
        stack<char> st;
        vector<bool> visited(26,false);
        vector<int>lastidx(26);

        for(int i=0;i<s.size();i++){
            lastidx[s[i]-'a']=i;
        }

        for(int i=0;i<s.size();i++){
            char ch=s[i];

            if(visited[ch-'a'])
              continue;
            
            //remove larger char if they apper later
            while(!st.empty() &&  st.top()> ch && lastidx[st.top()-'a']>i){
                visited[st.top()-'a']=false;
                st.pop();
            }
            st.push(ch);
            visited[ch-'a']=true;
               
            }
            string ans;

            while(!st.empty()){
                ans+=st.top();
                st.pop();
            }
            reverse(ans.begin(),ans.end());

           return ans;
        
    }
};

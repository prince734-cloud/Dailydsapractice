void insertion_sort(vector<int>& arr){
    int n= arr.size();
    
    for(int i=1;i<n;i++){
       int curr=arr[i];
        int prev=i-1;
        while(prev>=0 && arr[prev]>curr){
            arr[prev+1]=arr[prev];
            prev--;
        }
        arr[prev+1]=curr;
    }
}

void print_sort(vector<int>& arr) {
   // bubble_sort(arr);
   //selection_sort(arr);
   insertion_sort(arr);
    for (int i = 0; i < arr.size(); i++) {
        cout << arr[i] << " ";
    }
    cout << endl;
}

int main() {
    vector<int> arr = {2, 5, 3, 8, 99, 23, 93, 456, 958, 3};
    print_sort(arr);
    return 0;
}

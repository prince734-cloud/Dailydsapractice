class Solution {
public:
    long long sumAndMultiply(int n) {
        long long x=0;
        long long sum=0;
        long long val =1;

        while(n>0){
            int rem=n%10;
            if(rem!=0){
                x=rem*val+x;
                sum+=rem;
                val*=10;

            }
            n/=10;

        }
        return sum*x;
        
    }
};

class Solution {
public:
    int characterReplacement(string s, int k) {
        int left = 0;
        int maxlen = 0;
        int maxfreq = 0;
        vector<int> count(26, 0);

        for (int right = 0; right < s.length(); ++right) {
            // Increment frequency of current character
            count[s[right] - 'A']++;
            
            // Track the maximum frequency seen in any valid window so far
            maxfreq = max(maxfreq, count[s[right] - 'A']);

            // Current window size minus max frequency gives number of replacements needed.
            // If replacements needed > k, shrink window from the left.
            while ((right - left + 1) - maxfreq > k) {
                count[s[left] - 'A']--;
                left++;
            }

            // Record maximum valid window length
            maxlen = max(maxlen, right - left + 1);
        }

        return maxlen;
    }
};

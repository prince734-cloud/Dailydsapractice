class Solution {
public:
    int findLucky(vector<int>& arr) {

        unordered_map<int,int> st;

        for(int x : arr){
            st[x]++;
    
        }
        int count=-1;
        for(int i=0;i<arr.size();i++){
            if(arr[i]==st[arr[i]]){
                count =max(count,arr[i]);
            }
        }
        return count;
    }
        
};

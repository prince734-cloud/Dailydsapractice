class Solution {
public:
    int countElements(vector<int>& nums) {
        int mini=INT_MAX;
        int maxi=INT_MIN;
        for(int i :nums){
            mini=min(mini,i);
            maxi=max(maxi,i);

        }
        int count=0;

        for(int i=0;i<nums.size();i++){
            if(nums[i]>mini  && nums[i]<maxi){
                count++;

            }
        }
        return count;
        
    }
};
